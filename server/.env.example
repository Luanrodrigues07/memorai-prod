# ---- Banco de dados (Neon) ----
# Crie um projeto grátis em https://neon.tech e cole a connection string aqui.
# Formato: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Sessão ----
# Segredos aleatórios (o setup gera automaticamente no .env real).
JWT_SECRET="troque-por-um-segredo-aleatorio"

# ---- Servidor ----
PORT=4000
# Origem do frontend (para CORS / cookies em dev).
CLIENT_ORIGIN="http://localhost:5173"

# ---- Google OAuth + Calendar ----
# Crie em https://console.cloud.google.com (OAuth Client ID, tipo "Web application").
# Habilite a "Google Calendar API".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"
